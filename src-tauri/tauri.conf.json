{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Distant",
  "version": "0.3.3",
  "identifier": "app.distant.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Distant",
        "width": 880,
        "height": 560,
        "minWidth": 780,
        "minHeight": 520,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Prise en main à distance minimaliste",
    "longDescription": "Distant permet de contrôler un ordinateur à distance avec un ID et un mot de passe, via un relais auto-hébergé et un chiffrement de bout en bout.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCOUYxOTIxNUI0NTFFQjEKUldTeEhrVmJJUm1mbTdjQjBKUWduLzgwVUl5TzUyazZqN0VmVjNoVWEwbUJCNlJDUkRGM2l6MkgK",
      "endpoints": [
        "https://github.com/INFOTECH974/open-remote/releases/latest/download/latest.json"
      ]
    }
  }
}
